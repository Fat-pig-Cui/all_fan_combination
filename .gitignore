!/results/SHA256SUMS
!/results/validation-sample.json
!/results/reference-check.json
!/results/reference-sample-check.json
!/results/full/
/results/full/*
!/results/full/records.zip
!/results/full/archive.json
!/results/full/summary.json
!/results/full/audit.json
!/results/full/REPORT.md
!/results/sanma/
/results/sanma/*
!/results/sanma/records.zip
!/results/sanma/archive.json
!/results/sanma/summary.json
!/results/sanma/audit.json
!/results/sanma/REPORT.md
!/results/yakuman/
/results/yakuman/*
!/results/yakuman/summary.json
!/results/yakuman/witnesses.jsonl
!/results/yakuman/REPORT.md

